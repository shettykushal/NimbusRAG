# NimbusRAG environment variables
# Copy this file to .env and fill in your values.

# OpenAI API key — REQUIRED for answer generation.
# Used ONLY on the server side. Never exposed to the browser.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI model settings (optional — defaults shown)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Relevance threshold for retrieval (optional — default 0.45)
# Chunks below this cosine similarity are not used for answering.
RELEVANCE_THRESHOLD=0.45
